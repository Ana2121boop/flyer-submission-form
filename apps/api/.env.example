# Railway Postgres connection string (provided automatically when you add Postgres to your Railway project)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=flyer-images
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Emails on each new submission (resend.com). Leave RESEND_API_KEY blank to
# turn them all off.
RESEND_API_KEY=
# Head office notification: one address, or several separated by commas.
ADMIN_NOTIFY_EMAIL=
# Sender. onboarding@resend.dev works without a verified domain, but then Resend
# only delivers to the address the Resend account was created with. Copies to
# store owners (and the email field on the form) need an address on a domain
# verified in Resend.
FROM_EMAIL=onboarding@resend.dev
# Copies to store owners without a verified domain: the URL of the Gmail
# script web app (apps/api/gmail-sender.gs has the code and the setup steps).
# When set, store copies go out from that Gmail account instead of Resend.
# GMAIL_SCRIPT_URL=https://script.google.com/macros/s/.../exec
# Where store owners' replies to their copy go (optional).
# REPLY_TO_EMAIL=marketing@example.com
# Public URL of the app, for the "Open submission" link in the email.
PUBLIC_BASE_URL=http://localhost:3000
