# Railway Postgres connection string (provided automatically when you add Postgres to your Railway project)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=flyer-images
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Emails on each new submission: head office's alert, and the store's copy
# with the PDF. They go out through the Gmail script when GMAIL_SCRIPT_URL is
# set (apps/api/gmail-sender.gs has the code and the setup steps), otherwise
# through Resend (resend.com). With neither set, no emails are sent.
# GMAIL_SCRIPT_URL=https://script.google.com/macros/s/.../exec
RESEND_API_KEY=
# Head office alert: one address, or several separated by commas. Through
# Gmail, only Windsor addresses get it.
ADMIN_NOTIFY_EMAIL=
# Resend's sender. onboarding@resend.dev works without a verified domain, but
# then Resend only delivers to the address the Resend account was created with.
# Copies to store owners (and the email field on the form) need an address on
# a domain verified in Resend.
FROM_EMAIL=onboarding@resend.dev
# Where store owners' replies to their copy go (optional).
# REPLY_TO_EMAIL=marketing@example.com
# Public URL of the app, for the "Open submission" link in the email.
PUBLIC_BASE_URL=http://localhost:3000
